# Application
APP_ENV=development
APP_PORT=8080

# API documentation (/docs ReDoc UI + /docs/openapi.yaml). Defaults to on in
# development and off in production; set explicitly to override.
# SERVE_DOCS=true

# Database (full connection string)
DB_URL=postgres://dbuser:dbpassword@localhost:5432/dbname?sslmode=disable

# JWT / Auth
# ISSUER is the public base URL tokens are issued for.
ISSUER=http://localhost:8080
# Ed25519 private key (PKCS#8 PEM). Generate with:
#   openssl genpkey -algorithm ED25519 -out key.pem
# Leave empty in development to auto-generate an ephemeral key.
# CAUTION: production requires an explicit key and rejects ephemeral ones.
JWT_PRIVATE_KEY=
# Optional extra public keys (PKIX PEM) retained for verification during
# key rotation. One or more PEM blocks.
JWT_PUBLIC_KEYS=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=720

# Set to true only when running behind a trusted reverse proxy that sets
# X-Forwarded-For / X-Real-IP. Never enable this when exposed directly.
TRUST_PROXY=false

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Google credentials (optional). Set all three together to enable Sign in with
# Google; leave all empty to run email/password only. Partial config is rejected.
GOOGLE_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789
GOOGLE_REDIRECT_URL=http://localhost:8080/v1/auth/google/callback

# Sign in with Apple credentials. A paid Apple Developer account is required
# for real credentials; leave APPLE_CLIENT_ID empty to run without Apple.
# APPLE_PRIVATE_KEY is the full PKCS#8 PEM contents of the .p8 key file.
APPLE_CLIENT_ID=com.example.services
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URL=http://localhost:8080/v1/auth/apple/callback
