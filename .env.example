# Application
APP_ENV=development
APP_PORT=8080

# Database (full connection string)
DB_URL=postgres://dbuser:dbpassword@localhost:5432/dbname?sslmode=disable

# JWT / Auth
# Use a value of at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=720

# Set to true only when running behind a trusted reverse proxy that sets
# X-Forwarded-For / X-Real-IP. Never enable this when exposed directly.
TRUST_PROXY=false

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Google credentials (required until multi-provider support lands)
GOOGLE_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789
GOOGLE_REDIRECT_URL=http://localhost:8080/v1/auth/google/callback
